# Database (Postgres + PostGIS)
# DATABASE_URL is the session-capable connection — used by the SSE LISTEN relay
# and pg-boss (both need a persistent session). In prod this is the Supabase
# session pooler (…pooler.supabase.com:5432) or the direct connection.
DATABASE_URL="postgresql://notifeyes:notifeyes@localhost:5432/notifeyes"
# Optional: transaction-pooler URL for the high-churn Drizzle query pool on
# serverless (Vercel). Multiplexes many clients onto few backends so we don't
# exhaust the session-pooler / max_connections ceiling. In prod set this to the
# Supabase transaction pooler (…pooler.supabase.com:6543). Leave blank locally
# and on the worker — the query pool falls back to DATABASE_URL.
DATABASE_URL_POOLED=""

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-replace-me-in-prod"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Set both to add "Continue with Google" on /login.
# Google signs in EXISTING accounts only (matched by verified email).
# Redirect URI to register in Google Cloud: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email — Resend in prod, Mailpit (or just console) in dev.
# Leave blank to log emails to the server console.
RESEND_API_KEY=""
EMAIL_FROM="NotifEyes <hello@notifeyes.local>"

# Twilio SMS — STUBBED until all three are set (then real sends).
# From the Twilio console; the number must be SMS-capable, in E.164 (+1…).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# UploadThing (file uploads)
# Get from https://uploadthing.com/dashboard — leave blank to disable uploads in dev.
UPLOADTHING_TOKEN=""

# Payments. PAYMENTS_PROVIDER picks the adapter: "stub" (default — fabricated
# PaymentIntents, no network) or "stripe" (real Stripe API, test-mode keys
# until the LLC clears). The stub stays active even when keys are present, so a
# key in the env never silently goes live — set PAYMENTS_PROVIDER=stripe to flip.
# Webhook endpoint: <origin>/api/payments/webhook (STRIPE_WEBHOOK_SECRET from the
# Stripe CLI `stripe listen` or a dashboard endpoint).
PAYMENTS_PROVIDER="stub"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Client publishable key for the A3 card form (Payment Element). Inlined into the
# browser bundle at build. The billing-page card UI renders only when this AND
# STRIPE_SECRET_KEY are set; otherwise it shows a "connect Stripe" placeholder.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Maps + geocoding (Mapbox). Leave blank to use the free fallbacks:
# server geocoding falls back to Nominatim, map tiles to OpenStreetMap.
# A single public token (pk.…) works for both. Set the same value in both.
MAPBOX_TOKEN=""               # server-side geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=""   # client-side map tiles (inlined at build)

# Sentry (error monitoring). All optional — fully dormant when unset, and only
# *sends* in production (NODE_ENV=production). Set a DSN to enable capture:
SENTRY_DSN=""                 # server-side DSN
NEXT_PUBLIC_SENTRY_DSN=""     # client-side DSN (inlined at build)
# Build-time only — needed to upload source maps on the Vercel build:
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog (product analytics). Both optional — dormant when unset, and only
# active in production. Host is your region's ingestion URL
# (https://us.i.posthog.com or https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Push notifications (VAPID keys for Web Push)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@notifeyes.local"

# Worker process URL (for SSE relay to find pg-boss listener)
WORKER_URL="http://localhost:3001"

# Feature flags
NOTIFEYES_LAUNCH_METRO="sf_bay"

# --TODO: legal review --- flat match-fee pricing per brief §8 (V1 placeholder)
# $9.99 per booked match; $19.99 if confirmed within 24h of shift start, or
# if the shift is flagged urgent. ODs always pay nothing.
NOTIFEYES_MATCH_FEE_CENTS="999"
NOTIFEYES_SAMEDAY_FEE_CENTS="1999"
NOTIFEYES_SAMEDAY_THRESHOLD_HOURS="24"

# Database (Postgres + PostGIS)
# DATABASE_URL is the session-capable connection — used by the SSE LISTEN relay
# and pg-boss (both need a persistent session). In prod this is the Supabase
# session pooler (…pooler.supabase.com:5432) or the direct connection.
DATABASE_URL="postgresql://notifeyes:notifeyes@localhost:5432/notifeyes"
# Optional: transaction-pooler URL for the high-churn Drizzle query pool on
# serverless (Vercel). Multiplexes many clients onto few backends so we don't
# exhaust the session-pooler / max_connections ceiling. In prod set this to the
# Supabase transaction pooler (…pooler.supabase.com:6543). Leave blank locally
# and on the worker — the query pool falls back to DATABASE_URL.
DATABASE_URL_POOLED=""

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-replace-me-in-prod"
AUTH_URL="http://localhost:3000"

# Email — Resend in prod, Mailpit (or just console) in dev.
# Leave blank to log emails to the server console.
RESEND_API_KEY=""
EMAIL_FROM="NotifEyes <hello@notifeyes.local>"

# UploadThing (file uploads)
# Get from https://uploadthing.com/dashboard — leave blank to disable uploads in dev.
UPLOADTHING_TOKEN=""

# Stripe — STUBBED in V1. Real keys not required.
# When you swap to real Stripe later, set these.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Maps + geocoding (Mapbox). Leave blank to use the free fallbacks:
# server geocoding falls back to Nominatim, map tiles to OpenStreetMap.
# A single public token (pk.…) works for both. Set the same value in both.
MAPBOX_TOKEN=""               # server-side geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=""   # client-side map tiles (inlined at build)

# Push notifications (VAPID keys for Web Push)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@notifeyes.local"

# Worker process URL (for SSE relay to find pg-boss listener)
WORKER_URL="http://localhost:3001"

# Feature flags
NOTIFEYES_LAUNCH_METRO="sf_bay"

# --TODO: legal review --- flat match-fee pricing per brief §8 (V1 placeholder)
# $9.99 per booked match; $19.99 if confirmed within 24h of shift start, or
# if the shift is flagged urgent. ODs always pay nothing.
NOTIFEYES_MATCH_FEE_CENTS="999"
NOTIFEYES_SAMEDAY_FEE_CENTS="1999"
NOTIFEYES_SAMEDAY_THRESHOLD_HOURS="24"
